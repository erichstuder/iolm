{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "stm32f446re launch",
            "type": "probe-rs-debug",
            "request": "launch",
            "preLaunchTask": "examples_stm32f446re_build",
            "cwd": "${workspaceFolder}",
            "connectUnderReset": true,
            "chip": "STM32F446RE",
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": true,
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "examples/stm32f446re/target/thumbv7em-none-eabihf/debug/stm32f446re",
                    "rttEnabled": true,
                    "rttChannelFormats": [
                        {
                            "channelNumber": 0,
                            "dataFormat": "Defmt",
                            "logFormat": "{t:blue} {L:5} {s:blue}\n  {{m} @ {F}:{l}%dimmed}"
                        }
                    ]
                }
            ],
        },
        {
            "name": "std launch",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "examples_std_build",
            "program": "examples/std/target/debug/std",
            "env": {
                "RUST_LOG": "info"
            },
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
        }
    ]
}
